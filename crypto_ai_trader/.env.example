# ==============================================================================
# Crypto AI Trader - Environment Configuration Template
# Copy this file to .env and configure your parameters.
# NEVER COMMIT REAL API KEYS TO REPOSITORIES!
# ==============================================================================

# System & Environment
APP_NAME=CryptoAITrader
APP_ENV=paper                  # Options: paper | live | backtest
DEBUG=false
LOG_LEVEL=INFO                 # DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_FILE_PATH=logs/trader.log
SECRET_KEY=change-this-to-a-secure-random-64-character-string-in-production

# Exchange Selection
DEFAULT_EXCHANGE=binance       # binance | bybit

# Binance API Credentials (Leave empty or use testnet keys for paper mode)
BINANCE_API_KEY=your_binance_api_key_here
BINANCE_API_SECRET=your_binance_api_secret_here
BINANCE_TESTNET=true

# Bybit API Credentials
BYBIT_API_KEY=your_bybit_api_key_here
BYBIT_API_SECRET=your_bybit_api_secret_here
BYBIT_TESTNET=true

# Trading Symbols & Parameters
TRADING_PAIRS=BTC/USDT,ETH/USDT,SOL/USDT
DEFAULT_TIMEFRAME=15m
MAX_CANDLES_BUFFER=1000

# Strict Institutional Risk Management Limits
DEFAULT_RISK_PER_TRADE_PCT=1.0 # 0.1% to 5.0% max
MAX_POSITION_PERCENT=20.0       # Max capital allocation per position
MAX_OPEN_POSITIONS=3            # Max simultaneous open trades
DAILY_LOSS_LIMIT_PCT=3.0        # Circuit breaker trigger (daily max loss)
MAX_DRAWDOWN_PCT=10.0           # Maximum total account drawdown
MAX_LEVERAGE=3                  # Strict leverage ceiling
EMERGENCY_STOP_ENABLED=true     # Kill-switch active

# AI Model & Regime Settings
AI_CONFIDENCE_THRESHOLD=0.65    # Minimum ML model probability to take signal
WALK_FORWARD_SPLIT=60/20/20
RETRAIN_INTERVAL_HOURS=24

# Database
DATABASE_URL=sqlite:///data/trader.db

# Notifications (Optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# FastAPI Telemetry & API Server
API_HOST=127.0.0.1
API_PORT=8000
API_BEARER_TOKEN=
